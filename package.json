{
  "name": "adhigam-ias",
  "private": true,
  "version": "0.7.0",
  "type": "module",
  "scripts": {
    "dev": "vite --port=3000 --host=0.0.0.0",
    "start": "node server.ts",
    "build": "node scripts/set-build-type.mjs clear && vite build && node scripts/set-build-type.mjs release",
    "build:debug": "node scripts/set-build-type.mjs clear && vite build --mode debug && node scripts/set-build-type.mjs debug",
    "preview": "vite preview",
    "clean": "rm -rf dist server.js *.zip",
    "lint": "tsc --noEmit",
    "test": "tsx --test tests/**/*.test.ts",
    "version:patch": "npm version patch --no-git-tag-version",
    "version:minor": "npm version minor --no-git-tag-version",
    "version:major": "npm version major --no-git-tag-version",
    "package": "node scripts/package-versioned.mjs",
    "package:release": "node scripts/package-versioned.mjs",
    "package:debug": "node scripts/package-versioned.mjs --debug",
    "package:source": "node scripts/package-versioned.mjs --source",
    "package:dist": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/package-dist.ps1",
    "package:versioned": "node scripts/package-versioned.mjs"
  },
  "dependencies": {
    "@google/genai": "^2.4.0",
    "@tailwindcss/vite": "^4.3.3",
    "@vitejs/plugin-react": "^6.1.1",
    "dotenv": "^17.2.3",
    "express": "^4.21.2",
    "jszip": "^3.10.2",
    "lucide-react": "^0.546.0",
    "motion": "^12.23.24",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "tailwindcss": "^4.3.3",
    "vite": "^8.3.0"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^22.14.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "autoprefixer": "^10.4.21",
    "esbuild": "^0.25.0",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.21.0",
    "typescript": "^7.0.2"
  }
}
